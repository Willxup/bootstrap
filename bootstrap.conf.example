# 复制为 bootstrap.conf 后使用；bootstrap.conf 已被 Git 忽略。
# 配置文件只允许 BOOTSTRAP_KEY=value，不执行 shell 代码。

# 非交互运行的步骤。03/11/17 默认不选：改密码、禁 IPv6、线路测试更适合手动决定。
BOOTSTRAP_ONLY_STEPS=01,02,04,05,06,07,08,09,10,12,13,14,15,16
BOOTSTRAP_SKIP_STEPS=

BOOTSTRAP_HOSTNAME=server-01
BOOTSTRAP_TIMEZONE=UTC

BOOTSTRAP_SSH_PORT=2222
BOOTSTRAP_OLD_SSH_PORT=22
# 首次执行建议保留旧端口，确认新端口可登录后再手动关闭。
BOOTSTRAP_KEEP_OLD_SSH_PORT=true

# 可直接填写公钥，或填写公钥文件路径；二选一。
BOOTSTRAP_SSH_PUBLIC_KEY=
BOOTSTRAP_SSH_PUBLIC_KEY_FILE=

# minimal: 仅 BBR + FQ；standard: 32 MiB TCP buffer；low-memory: 8 MiB buffer。
BOOTSTRAP_NETWORK_PROFILE=minimal

# 小内存 VPS 默认档。约 10 GiB 且运行较多服务时可参考 4G / 20 / 20。
BOOTSTRAP_SWAP_SIZE=1G
BOOTSTRAP_ZRAM_PERCENT=25
BOOTSTRAP_ZRAM_ALGO=lz4
BOOTSTRAP_SWAP_PRIORITY=10
BOOTSTRAP_ZRAM_PRIORITY=100
BOOTSTRAP_SWAPPINESS=40
BOOTSTRAP_VFS_CACHE_PRESSURE=100

# 不使用哪吒时保持为空，步骤 09 会安全跳过。
BOOTSTRAP_NEZHA_SERVER=monitor.example.com:5555
BOOTSTRAP_NEZHA_TLS=true
BOOTSTRAP_NEZHA_SECRET=
